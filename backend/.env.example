# Spotify Client Credentials (app-level auth only - no user login).
#
# The captain must create a Spotify developer app at
# https://developer.spotify.com/dashboard to get real values.
# Until then, the placeholder values below let the app boot and let the
# test suite run (tests mock all Spotify HTTP calls and never use these
# credentials for a real request).
SPOTIFY_CLIENT_ID=placeholder-client-id
SPOTIFY_CLIENT_SECRET=placeholder-client-secret

# Postgres connection string. The docker-compose.yml at the repo root spins
# up a matching local Postgres instance for development.
DATABASE_URL=postgresql+psycopg://soundprint:soundprint@localhost:5432/soundprint

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000
